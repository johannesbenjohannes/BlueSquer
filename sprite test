import pygame
from pygame.time import Clock
from graphics.color_palette import *
import sys
cx = 40
cy=35

pygame.init()


def main():
    fenetre = pygame.display.set_mode((70, 70))
    fenetre.fill((255,255,255))
    clock = Clock()
    while True:
        for event in pygame.event.get():
                    if event.type == pygame.QUIT:
                        pygame.quit()
                        sys.exit()
        fenetre.fill((255,255,255))
        pygame.draw.ellipse(fenetre, BLUE, (cx - 12, cy - 22, 24, 38))   # body
        pygame.draw.ellipse(fenetre, BLUE, (cx - 30, cy - 10, 18, 12))   # left claw
        pygame.draw.ellipse(fenetre, BLUE, (cx + 12, cy - 10, 18, 12))   # right claw
        pygame.draw.line(fenetre, BLUE, (cx - 6, cy - 22), (cx - 20, cy - 38), 2)  # antennae
        pygame.draw.line(fenetre, BLUE, (cx + 6, cy - 22), (cx + 20, cy - 38), 2)
        pygame.draw.ellipse(fenetre, BLUE, (cx - 8, cy + 16, 16, 10))    # tail

        pygame.display.flip()
        clock.tick(60)

if __name__=="__main__":
    main()
